DATABASE_URL=postgres://music:music@postgres:5432/music?sslmode=disable
POSTGRES_USER=music
POSTGRES_PASSWORD=music
POSTGRES_DB=music

HTTP_ADDR=:8080
WORKER_HEALTH_ADDR=:8081
WORKER_INSTANCE_ID=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=music
S3_REGION=us-east-1
S3_ACCESS_KEY=music
S3_SECRET_KEY=musicsecret
S3_USE_SSL=false
S3_USE_PATH_STYLE=true

AUDIO_TEMP_DIR=/tmp/music-audio
AUDIO_MAX_BYTES=209715200
AUDIO_PROCESS_TIMEOUT=10m
PLAYBACK_URL_TTL=1h
LOCAL_AUDIO_DIR=/app/testdata/audio
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=music/1.0 ( https://github.com/helltale/music )

API_UPSTREAM=http://music-api:8080

# Пусто — локальные теги :dev и сборка из исходников.
# На стенде сюда ставится тег git-<sha> или digest из GHCR. Образ заново не собирается.
MUSIC_API_IMAGE=
MUSIC_WORKER_IMAGE=
MUSIC_WEB_IMAGE=

LEASE_TIMEOUT=2m
LEASE_HEARTBEAT=30s
SYNC_INTERVAL=24h
SHUTDOWN_TIMEOUT=25s
MIGRATIONS_DIR=/app/migrations
